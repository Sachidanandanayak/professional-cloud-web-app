# FastAPI Backend Environment Configuration
# Copy this file to .env and configure environment-specific values before deployment

PROJECT_NAME="Professional Cloud Web App API"
API_V1_STR="/api"

# Mandatory Production Security Keys — generate strong unique strings (e.g. `openssl rand -hex 32`)
SECRET_KEY="YOUR_SECURE_RANDOM_SECRET_KEY_HERE"
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Settings
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="YOUR_DATABASE_PASSWORD_HERE"
MYSQL_DATABASE="nexuscloud"

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
